# Neon Postgres connection string (paste yours here)
# Example: postgresql://user:pass@host.neon.tech/dbname?sslmode=require
DATABASE_URL="postgresql://user:password@host.neon.tech/dbname?sslmode=require"

# Random 32+ character secret used to sign session JWTs.
AUTH_SECRET="change-me-to-a-long-random-string-in-production"

# ── OTP email delivery ─────────────────────────────────────────────────────
# If SMTP_HOST is empty, OTPs are printed to the server console (dev mode).
# For production, fill in these values (e.g. Resend SMTP, Gmail App Password,
# Mailgun, SendGrid, Postmark, or any SMTP relay).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Ledger <no-reply@ledger.app>"
